# Copiez ce fichier en `.env` (jamais commité) et remplissez les valeurs.

# --- Application ---
APP_ENV=development            # development | test | production
DEBUG=false
AUTO_INIT_DB=true              # crée les tables + le catalogue d'actifs au démarrage (idempotent)

# --- PostgreSQL ---
# Local  : postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/crypto_arena
# Hébergé: URL fournie par Render / Railway / Supabase / Neon (postgres:// accepté), ajoutez ?sslmode=require si demandé
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@localhost:5432/crypto_arena

# --- Authentification JWT ---
# Générez une valeur aléatoire : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CoinGecko (plan Demo : https://www.coingecko.com/en/developers/dashboard) ---
# La clé reste côté serveur (en-tête x-cg-demo-api-key). Sans clé, l'API publique fonctionne avec des limites plus basses.
COINGECKO_API_KEY=
COINGECKO_TIMEOUT_SECONDS=10
COINGECKO_MAX_RETRIES=2
COINGECKO_CACHE_TTL_MARKETS=60
COINGECKO_CACHE_TTL_PRICES=30
COINGECKO_CACHE_TTL_COIN=120
COINGECKO_CACHE_TTL_HISTORY=300

# --- Connexion Google / GitHub via Neon Auth (optionnel, vide = désactivée) ---
# "Auth URL" de la branche dans la console Neon (onglet Auth). Sert à vérifier les jetons, ce n'est pas un secret.
NEON_AUTH_URL=

# --- Règles du jeu ---
INITIAL_BALANCE=10000
SNAPSHOT_INTERVAL_MINUTES=60
LEADERBOARD_CACHE_TTL=30

# --- CORS : origines autorisées séparées par des virgules (URL du frontend) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
