# Copiez ce fichier en `.env` (ou `.env.local`). Seules les variables préfixées VITE_ sont exposées au navigateur :
# n'y placez JAMAIS de secret (clé CoinGecko, JWT_SECRET...). Le frontend ne parle qu'au backend.

# URL du backend FastAPI, sans slash final (le client ajoute /api)
VITE_API_URL=http://localhost:8000

# Connexion Google / GitHub via Neon Auth (optionnel, laisser vide pour masquer les boutons).
# Adresse "Auth URL" de la branche, visible dans la console Neon, onglet Auth. Ce n'est pas un secret.
VITE_NEON_AUTH_URL=
# Fournisseurs configurés dans Neon Auth : google, github ou google,github
VITE_OAUTH_PROVIDERS=google
